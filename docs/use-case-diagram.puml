
@startuml
left to right direction
skinparam shadowing false

actor "Користувач" as User
actor "Студент" as Student
actor "Викладач" as Teacher

User <|-- Student
User <|-- Teacher

rectangle "Вебсистема керування навчальними завданнями" {

  usecase "Увійти до системи" as Login

  usecase "Переглянути\nзавдання" as ViewTasks
  usecase "Подати\nвиконану роботу" as Submit
  usecase "Переглянути\nоцінки" as ViewGrades
  usecase "Перевірити можливість\nподання роботи" as CheckSubmit

  usecase "Створити\nзавдання" as CreateTask
  usecase "Перевірити\nроботу" as Review
  usecase "Виставити\nоцінку" as SetGrade
  usecase "Повернути роботу\nна доопрацювання" as ReturnWork
}

User -- Login

Student -- ViewTasks
Student -- Submit
Student -- ViewGrades

Teacher -- CreateTask
Teacher -- Review
Teacher -- SetGrade

Submit ..> CheckSubmit : <<include>>
ReturnWork ..> Review : <<extend>>
Teacher -- ReturnWork

@enduml